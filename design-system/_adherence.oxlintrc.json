{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "styleguide.jsx",
              "ui_kits/worldcupelo/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Archivo Expanded|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Archivo Expanded, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|arrow|disabled|href|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, arrow, disabled, href, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|confederation|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, variant, confederation, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:confederation|host|gold|neutral)$/]",
        "message": "<Chip> variant must be one of 'confederation' | 'host' | 'gold' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|live|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, live, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|dim|gold)$/]",
        "message": "<Eyebrow> tone must be one of 'muted' | 'dim' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagThumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|name|size|lift|style|key|ref|className|style|children)$/]",
        "message": "<FlagThumb> doesn't accept that prop. Declared props: code, name, size, lift, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagThumb'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg)$/]",
        "message": "<FlagThumb> size must be one of 'xs' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Emblem'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<Emblem> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsTicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|label|speed|style|key|ref|className|style|children)$/]",
        "message": "<NewsTicker> doesn't accept that prop. Declared props: items, label, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProbabilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:win|draw|loss|height|showLabels|style|key|ref|className|style|children)$/]",
        "message": "<ProbabilityBar> doesn't accept that prop. Declared props: win, draw, loss, height, showLabels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|tone|glow|style|key|ref|className|style|children)$/]",
        "message": "<RatingValue> doesn't accept that prop. Declared props: value, size, tone, glow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingValue'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg|xl|2xl)$/]",
        "message": "<RatingValue> size must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingValue'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|primary|muted|green|red)$/]",
        "message": "<RatingValue> tone must be one of 'gold' | 'primary' | 'muted' | 'green' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|size|right|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: title, subtitle, size, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SectionHeading> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|accent|big|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, sub, accent, big, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:gold|primary)$/]",
        "message": "<StatTile> accent must be one of 'gold' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|code|name|rating|confederation|host|wcTitles|showTier|showConfederation|onClick|href|style|key|ref|className|style|children)$/]",
        "message": "<TeamRow> doesn't accept that prop. Declared props: rank, code, name, rating, confederation, host, wcTitles, showTier, showConfederation, onClick, href, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
